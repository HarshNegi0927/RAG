# Copy this file to .env and fill in real values. .env itself is gitignored
# on purpose -- never commit real keys. This file (.env.example) has no
# secrets in it and is safe to commit/share.

# Required for the default generation provider (GENERATION_PROVIDER=groq
# in config.py). Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Only needed if you switch GENERATION_PROVIDER to "grok" in config.py
# XAI_API_KEY=

# Only needed if you switch GENERATION_PROVIDER to "anthropic"
# ANTHROPIC_API_KEY=

# Only needed if you switch GENERATION_PROVIDER to "openai", or
# EMBEDDING_PROVIDER to "openai"
# OPENAI_API_KEY=
